# Referencia de variables para desarrollo local en Windows.
# Copia .env.local.example como .env.local y utiliza el puerto 5432 del servicio PostgreSQL local.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/cv
ADMIN_PASSWORD=password
ADMIN_SESSION_SECRET=CAMBIA_POR_UN_SECRETO_ALEATORIO_DE_48_CARACTERES_O_MAS
ADMIN_SECURE_COOKIE=false
DEVFOLIO_STORAGE=postgres

# Copia este archivo como .env.local y completa tus valores privados.
# Conecta con PostgreSQL instalado en Windows y la base de datos existente cv.
DATABASE_URL=postgresql://postgres:CAMBIA_POR_TU_CLAVE@127.0.0.1:5432/cv

# Contraseña independiente del administrador (mínimo 16 caracteres).
ADMIN_PASSWORD=CAMBIA_POR_UNA_CLAVE_ADMIN_SEGURA_DE_16_CARACTERES
ADMIN_SESSION_SECRET=CAMBIA_POR_UN_SECRETO_ALEATORIO_DE_48_CARACTERES_O_MAS
ADMIN_SECURE_COOKIE=false

# El proyecto usa PostgreSQL; no activa el almacenamiento en archivos.
DEVFOLIO_STORAGE=postgres
